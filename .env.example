# ─────────────────────────────────────────────────────────────
# Mousey — local-only configuration. NO cloud API keys required.
# Copy this file to `.env` and adjust if needed.
# ─────────────────────────────────────────────────────────────

# Local Ollama inference runtime (https://ollama.ai)
# Mousey's AI prompt generation + copy rewriting run entirely here.
OLLAMA_BASE_URL=http://localhost:11434

# SSRF guard: the server only fetches loopback Ollama endpoints
# (localhost / 127.0.0.0/8 / ::1) by default. If you run Ollama on another
# machine, opt that host in here (comma-separated host or host:port entries).
# OLLAMA_ALLOWED_HOSTS=ollama.lan:11434,gpu-box

# Default local model. Pull it first with:  ollama pull llama3
# You may also use: mistral, llama3.1, qwen2.5, etc.
OLLAMA_MODEL=llama3

# Generation tuning (overridable in the in-app Settings panel)
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=2048

# Local mock subscription store (JSON file). No external DB, no Stripe.
# To use a real database later, see STRIPE_MIGRATION.md.
DATABASE_URL=file:./data/subscriptions.json
